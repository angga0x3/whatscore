# WhatsCore configuration (spec §10). Copy to .env and adjust.
#   cp .env.example .env

# Application
APP_NAME=WhatsCore
APP_ENV=development
APP_PORT=8080
APP_LOG_LEVEL=debug

# Database
#   - Inside Docker Compose the host is `postgres` (the service name).
#   - For a bare-metal run, use localhost instead.
DATABASE_URL=postgres://whatscore:password@postgres:5432/whatscore?sslmode=disable
# Apply schema migrations automatically on startup.
DB_MIGRATE_ON_STARTUP=true

# PostgreSQL container settings (docker-compose.yml only)
POSTGRES_USER=whatscore
POSTGRES_PASSWORD=password
POSTGRES_DB=whatscore

# Authentication
API_KEY_REQUIRED=true

# Sessions
WHATSAPP_SESSION_LIMIT=10
# Operator-supplied WhatsApp token table (ADR 0002). Never committed.
# Validated at startup: source, ISO observation date, and licence are required.
#   go run ./cmd/tokendict -in ./table.json -check
WHATSAPP_TOKEN_DICTIONARY=

# Media
MEDIA_STORAGE=local
MEDIA_PATH=./storage/media
MEDIA_MAX_SIZE_MB=50

# Webhooks
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=10

# Security
#   Required in production. Generate one with: openssl rand -base64 32
ENCRYPTION_KEY=
