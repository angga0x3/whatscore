# Binaries
/bin/
/dist/
*.exe
# Locally built tools (go build ./cmd/x writes next to the package otherwise)
/whatscore
/whatscore-probe

# Local environment and secrets
.env
*.env.local

# Runtime data
/storage/media/
# Raw frames captured during a pairing attempt: they carry the account JID
/undecoded/
# Paired credentials: private keys and the account JID. Never commit.
paired*.json
*.creds.json
# Private halves of published prekeys: losing them is unrecoverable, leaking
# them is worse.
*.keys.json
*.log
coverage.out
coverage.html

# Editors and OS
.idea/
.vscode/
.DS_Store

# Go tooling
vendor/
